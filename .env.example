# Environment variables for flower-exchange backend

# Port the application listens on (Railway sets this automatically)
# If not set, defaults to 5555
PORT=5555

# Future: Database configuration (when needed)
# DATABASE_URL=postgresql://user:password@localhost:5432/flower_exchange
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=flower_exchange

# Future: Redis configuration (for caching/sessions)
# REDIS_URL=redis://localhost:6379

# Application configuration
# APP_ENV=production
# LOG_LEVEL=info
